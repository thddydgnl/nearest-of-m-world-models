# OS, editor and Python caches
.DS_Store
__pycache__/
*.pyc
.claude/

# Queue-runner lock files
*.lock

# LaTeX build files
/paper/**/*.aux
/paper/**/*.out
/paper/**/*.log
/paper/**/*.blg
/paper/**/*.bbl
/paper/**/*.synctex.gz
/paper/**/*.fls
/paper/**/*.fdb_latexmk
/paper/**/*.xdv

# Model checkpoints, datasets and token caches stay on the GPU server (see README "Data not in git")
*.pt
*.npz
*.npy

# Generated arXiv bundle (rebuilt by paper/build/make_arxiv.sh; the tarball and PDF are kept)
/paper/arxiv/src/
/paper/arxiv/build.log

# Font faces extracted from the system font for the slide figures (paper/slides/slidefig.py)
/paper/slides/.fontcache/

# RunPod runtime files (pod addresses, ledger, logs); the tools themselves are tracked
/runpod/pods/
/runpod/pods.ledger
/runpod/pods.seen.json
/runpod/watchdog.log
